{
  "id": "patterns01",
  "name": "Webhook to Postgres upsert",
  "nodes": [
    {
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "responseMode": "lastNode"
      }
    },
    {
      "id": "2",
      "name": "Validate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ]
        }
      }
    },
    {
      "id": "3",
      "name": "Upsert lead",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        440,
        -80
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO leads (email, name, source, updated_at)\nVALUES ($1, $2, $3, now())\nON CONFLICT (email) DO UPDATE\n  SET name = EXCLUDED.name, source = EXCLUDED.source, updated_at = now()\nRETURNING id, email;",
        "options": {
          "queryReplacement": "={{ [$json.body.email.toLowerCase().trim(), $json.body.name ?? null, $json.body.source ?? 'webhook'] }}"
        }
      }
    },
    {
      "id": "4",
      "name": "Reject",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        120
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "error",
              "value": "email is required",
              "type": "string"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Validate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate": {
      "main": [
        [
          {
            "node": "Upsert lead",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}